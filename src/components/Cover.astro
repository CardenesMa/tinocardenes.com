---
import Page from './Page.astro';
import { site } from '../site';

const { edition } = site;

// Sunburst rays fanning out behind the arch, Mucha-style.
const rays = Array.from({ length: 27 }, (_, i) => {
  const angle = ((205 + i * 5) * Math.PI) / 180;
  const at = (r: number) => [380 + r * Math.cos(angle), 400 + r * Math.sin(angle)].map((n) => n.toFixed(1));
  const [x1, y1] = at(240);
  const [x2, y2] = at(i % 2 ? 330 : 420);
  return { x1, y1, x2, y2 };
});
const petals = [0, 60, 120, 180, 240, 300];

// Shapes reused through <use> don't pick up stylesheet rules reliably, so they carry inline styles.
const ink = 'stroke: var(--cover-ink); stroke-linecap: round;';
const vine = `fill: none; ${ink} stroke-width: 2.6;`;
const tendril = `fill: none; ${ink} stroke-width: 1.5;`;
const leaf = `fill: var(--gold); ${ink} stroke-width: 1.1;`;
const petal = `fill: var(--cover-panel); ${ink} stroke-width: 1.3;`;
const bud = `fill: var(--gold); ${ink} stroke-width: 1;`;
---

<Page side="right" plate={false} class="page--cover">
  <svg class="cover-art" viewBox="0 0 760 1000" aria-hidden="true">
    <defs>
      <clipPath id="cover-inside"><rect x="36" y="36" width="688" height="928"></rect></clipPath>
      <path id="cover-leaf" style={leaf} d="M0 0 C 8 -10 26 -11 36 0 C 26 11 8 10 0 0 Z"></path>
      <g id="cover-poppy">
        {petals.map((deg) => <ellipse style={petal} cx="0" cy="-17" rx="9.5" ry="16" transform={`rotate(${deg})`} />)}
        <circle style={bud} r="8"></circle>
        <circle style="fill: var(--cover-ink)" r="3"></circle>
      </g>
      <g id="cover-half">
        <path style={vine} d="M64 968 C 40 880 118 830 100 730 C 86 650 44 610 62 520 C 76 452 128 440 126 476 C 124 500 98 500 98 482 C 98 470 110 468 112 478"></path>
        <path style={tendril} d="M96 968 C 112 900 70 860 84 790 C 96 730 136 722 138 662"></path>
        <path style={tendril} d="M92 168 C 84 232 126 272 112 332 C 104 366 82 382 88 418"></path>
        <use href="#cover-leaf" transform="translate(101 728) rotate(-118) scale(1.15)"></use>
        <use href="#cover-leaf" transform="translate(66 612) rotate(-62)"></use>
        <use href="#cover-leaf" transform="translate(84 846) rotate(-150) scale(.9)"></use>
        <use href="#cover-leaf" transform="translate(110 300) rotate(-20) scale(.8)"></use>
        <use href="#cover-leaf" transform="translate(84 790) rotate(-30) scale(.8)"></use>
        <circle style={bud} cx="138" cy="656" r="5"></circle>
        <circle style={bud} cx="88" cy="424" r="4"></circle>
        <use href="#cover-poppy" transform="translate(92 140) scale(1.35)"></use>
        <use href="#cover-poppy" transform="translate(70 968) scale(.8)"></use>
      </g>
    </defs>

    <rect class="frame" x="22" y="22" width="716" height="956"></rect>
    <rect class="frame thin" x="32" y="32" width="696" height="936"></rect>

    <g class="rays" clip-path="url(#cover-inside)">
      {rays.map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} />)}
    </g>

    <path class="panel" d="M150 790 V 400 A 230 230 0 0 1 610 400 V 790 Z"></path>
    <path class="frame thin" d="M162 778 V 400 A 218 218 0 0 1 598 400 V 778 Z"></path>
    <circle class="halo" cx="380" cy="400" r="200"></circle>
    <circle class="halo dotted" cx="380" cy="400" r="190"></circle>

    <use href="#cover-half"></use>
    <use href="#cover-half" transform="translate(760 0) scale(-1 1)"></use>

    <line class="frame" x1="190" y1="828" x2="570" y2="828"></line>
    <line class="frame thin" x1="230" y1="836" x2="530" y2="836"></line>
  </svg>

  <div class="cover-text">
    <p class="cover-name">{site.name}</p>
    <h1 class="cover-work">{edition.work}</h1>
    <p class="cover-scoring">{edition.scoring}</p>
    <div class="cover-incipit" aria-hidden="true">
      <span class="cover-marking">{edition.marking}</span>
      <div class="staff"><span class="staff-clef">𝄞</span><span class="staff-time">𝄴</span></div>
    </div>
    <p class="cover-roles">{edition.roles.join(' · ')}</p>
    <p class="cover-place">{edition.place}</p>
    <p class="cover-urtext">Urtext</p>
    <p class="cover-publisher">tinocardenes.com</p>
    <p class="cover-plate">{edition.plate}</p>
  </div>

  <a class="cover-open" href="#contents" data-turn="next"><span class="visually-hidden">Open the score</span></a>
</Page>
