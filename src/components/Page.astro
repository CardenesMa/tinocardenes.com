---
import { site } from '../site';

interface Props {
  side: 'left' | 'right';
  /** Page number printed in the outer top corner (the folio). Omit on covers. */
  number?: number | null;
  /** Print the edition's plate number at the foot of the page, as engraved scores do. */
  plate?: boolean;
  class?: string;
}

const { side, number, plate = true, class: className } = Astro.props;
---

<div class:list={['page', `page--${side}`, className]}>
  {number != null && <span class="folio" aria-label={`Page ${number}`}>{number}</span>}
  <div class="page-body">
    <slot />
  </div>
  {plate && <span class="plate-no" aria-hidden="true">{site.edition.plate}</span>}
</div>
