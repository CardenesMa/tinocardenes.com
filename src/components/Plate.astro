---
// A full-page illustration: an engraved score, a portrait, or a figure.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  kind?: 'score' | 'portrait' | 'figure';
}

const { image, alt, caption, kind = 'score' } = Astro.props;
---

<figure class:list={['plate', `plate--${kind}`]}>
  <Image src={image} alt={alt} width={1100} widths={[480, 760, 1100, 1500]} sizes="(max-width: 860px) 92vw, 46vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
