---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Page from '../components/Page.astro';
import ScoreHeading from '../components/ScoreHeading.astro';
import Plate from '../components/Plate.astro';
import YouTube from '../components/YouTube.astro';
import Cover from '../components/Cover.astro';
import Contents from '../components/Contents.astro';
import BackCover from '../components/BackCover.astro';
import { getBook, pageLabel } from '../lib/book';
import { site } from '../site';
import placeholderScore from '../assets/scores/placeholder.png';

const { spreads, toc, pageCount } = await getBook();

// Render every Markdown body up front so the template can drop them in.
const bodies = new Map(
  await Promise.all(
    spreads.map(async (s) => {
      const entry = s.kind === 'contents' ? s.preface : s.kind === 'section' || s.kind === 'recording' ? s.entry : null;
      return [s.id, entry ? (await render(entry)).Content : null] as const;
    }),
  ),
);
const works = await Promise.all(
  (spreads.find((s) => s.kind === 'works')?.works ?? []).map(async (w) => ({ ...w, Content: (await render(w)).Content })),
);
const worksSplit = Math.ceil(works.length / 2);
---

<Base>
  <header class="toolbar">
    <a class="toolbar-title" href="#cover">{site.name} <span>· {site.edition.work}</span></a>
    <div class="pager">
      <button type="button" class="pager-btn" data-turn="prev" aria-label="Previous pages">‹</button>
      <span class="pager-label"><span data-pager-pages>1</span> / {pageCount}</span>
      <button type="button" class="pager-btn" data-turn="next" aria-label="Next pages">›</button>
    </div>
    <a class="toolbar-contents" href="#contents">Contents</a>
  </header>

  <main class="desk">
    <button type="button" class="edge edge--prev" data-turn="prev" aria-label="Previous pages"></button>
    <button type="button" class="edge edge--next" data-turn="next" aria-label="Next pages"></button>

    <div class="book" data-book data-mode="cover">
      <a class="ribbon" href="#contents" title="Return to contents">
        <span class="visually-hidden">Return to contents</span>
      </a>

      {
        spreads.map((s) => {
          const Body = bodies.get(s.id);
          const mode = s.kind === 'cover' ? 'cover' : s.kind === 'back' ? 'back' : 'open';
          return (
            <article
              class:list={['spread', `spread--${s.kind}`, { 'is-current': s.kind === 'cover' }]}
              id={s.id}
              data-spread
              data-mode={mode}
              data-pages={pageLabel(s)}
              data-title={s.title}
              aria-label={`${s.title}, page ${pageLabel(s)}`}
              tabindex="-1"
            >
              {s.kind === 'cover' && (
                <>
                  <div class="page page--empty" aria-hidden="true" />
                  <Cover />
                </>
              )}

              {s.kind === 'contents' && Body && (
                <>
                  <Contents entries={toc} number={s.left} />
                  <Page side="right" number={s.right}>
                    <ScoreHeading title={s.preface.data.title} marking={s.preface.data.marking} />
                    <div class="prose">
                      <Body />
                    </div>
                    <p class="signature">T. C. · {site.edition.place.split(',')[0]}, {site.edition.year}</p>
                  </Page>
                </>
              )}

              {s.kind === 'section' && Body && (
                <>
                  <Page side="left" number={s.left}>
                    <ScoreHeading {...s.entry.data} />
                    <div class="prose">
                      <Body />
                    </div>
                    {s.entry.data.links.length > 0 && (
                      <ul class="page-links">
                        {s.entry.data.links.map((l) => (
                          <li>
                            <a href={l.href} download={l.download || undefined} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                              {l.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </Page>
                  <Page side="right" number={s.right}>
                    {s.entry.data.plate ? (
                      <Plate {...s.entry.data.plate} />
                    ) : (
                      <Plate image={placeholderScore} alt="Placeholder score page" />
                    )}
                  </Page>
                </>
              )}

              {s.kind === 'works' && (
                <>
                  {[works.slice(0, worksSplit), works.slice(worksSplit)].map((column, i) => (
                    <Page side={i === 0 ? 'left' : 'right'} number={i === 0 ? s.left : s.right}>
                      {i === 0 ? (
                        <ScoreHeading title="Works" subtitle="Projects, ensembles, and software" />
                      ) : (
                        <p class="running-head">Works (continued)</p>
                      )}
                      <ol class="works" start={i * worksSplit + 1}>
                        {column.map((w) => (
                          <li class="work">
                            <h3 class="work-title">
                              <span class="work-no">No. {w.data.order}</span> {w.data.title}
                            </h3>
                            {(w.data.role || w.data.year) && (
                              <p class="work-role">{[w.data.role, w.data.year].filter(Boolean).join(', ')}</p>
                            )}
                            <div class="prose">
                              <w.Content />
                            </div>
                            <a
                              class="work-link"
                              href={w.data.href}
                              {...(w.data.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                            >
                              {w.data.linkLabel ?? 'Visit'} →
                            </a>
                          </li>
                        ))}
                      </ol>
                    </Page>
                  ))}
                </>
              )}

              {s.kind === 'recording' && Body && (
                <>
                  <Page side="left" number={s.left}>
                    <ScoreHeading {...s.entry.data} />
                    <YouTube id={s.entry.data.youtubeId} title={s.entry.data.title} aspect={s.entry.data.aspect} />
                    <div class="prose">
                      <Body />
                    </div>
                    <a class="work-link" href={`https://www.youtube.com/watch?v=${s.entry.data.youtubeId}`} target="_blank" rel="noopener noreferrer">
                      Watch on YouTube →
                    </a>
                  </Page>
                  <Page side="right" number={s.right}>
                    <Plate
                      image={s.entry.data.leadSheet ?? placeholderScore}
                      alt={`Lead sheet for ${s.entry.data.title}`}
                    />
                  </Page>
                </>
              )}

              {s.kind === 'back' && (
                <>
                  <BackCover />
                  <div class="page page--empty" aria-hidden="true" />
                </>
              )}
            </article>
          );
        })
      }
    </div>

    <p class="hint">Use ← → to turn pages · <kbd>C</kbd> for contents</p>
    <p class="visually-hidden" aria-live="polite" data-announcer></p>
  </main>

  <script is:inline>
    // Open straight to a linked spread (e.g. /#biography) before first paint.
    (function () {
      var target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (!target || !target.hasAttribute('data-spread')) return;
      document.querySelector('.spread.is-current').classList.remove('is-current');
      target.classList.add('is-current');
      document.querySelector('[data-book]').dataset.mode = target.dataset.mode;
    })();
  </script>
  <script>
    import { initReader } from '../scripts/reader';
    initReader();
  </script>
</Base>
